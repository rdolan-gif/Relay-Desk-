{
  "name": "relay-desk",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --filter=!@relay-desk/e2e typecheck && tsc -p e2e/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @relay-desk/api dev",
    "dev:web": "pnpm --filter @relay-desk/web dev",
    "db:generate": "pnpm --filter @relay-desk/api db:generate",
    "db:migrate": "pnpm --filter @relay-desk/api db:migrate",
    "db:seed": "pnpm --filter @relay-desk/api db:seed",
    "test:e2e": "pnpm --filter @relay-desk/e2e test:e2e",
    "format:check": "prettier --check .",
    "db:install": "pnpm --filter @relay-desk/api db:install",
    "db:setup:support": "pnpm --filter @relay-desk/api db:setup:support"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
