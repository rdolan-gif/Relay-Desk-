# Copy to .env for local overrides. Defaults work with docker compose.
DATABASE_URL=postgres://relay:relay@localhost:5432/relay_desk
TEST_DATABASE_URL=postgres://relay:relay@localhost:5432/relay_desk_test
REDIS_URL=redis://localhost:6379
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
COOKIE_SECURE=false
# Proxies trusted for the visitor's real IP (default: this machine and private networks).
# TRUST_PROXY=loopback, linklocal, uniquelocal
# Live server only (docker-compose.prod.yml): the database password.
# POSTGRES_PASSWORD=
WEB_ORIGIN=http://localhost:5173
# Object storage (MinIO locally; any S3-compatible service in production). Used from Phase 2.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=relay-desk
S3_ACCESS_KEY=relay
S3_SECRET_KEY=relay-secret
# Test mail server (Mailpit). Used from Phase 3.
SMTP_HOST=localhost
SMTP_PORT=1025
SEED_PASSWORD=

# Gmail (Phase 3) — see docs/setup/gmail.md
PUBLIC_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Staff sign-in with Google (docs/setup/go-live.md). Empty = off.
GOOGLE_SIGNIN_DOMAIN=
# all | administrators (emergency only, needs two-factor) | none
PASSWORD_SIGNIN=all
MAIL_POLL_SECONDS=60
STORAGE_DIR=./data/storage
